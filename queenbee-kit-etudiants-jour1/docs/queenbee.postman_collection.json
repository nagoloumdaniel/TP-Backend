{
  "info": {
    "name": "Queen Bee API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "GET /health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "GET /api/hives",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/hives",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "hives"
          ]
        }
      }
    },
    {
      "name": "GET /api/hives filtre site_id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/hives?site_id=SN-CASA",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "hives"
          ],
          "query": [
            {
              "key": "site_id",
              "value": "SN-CASA"
            }
          ]
        }
      }
    },
    {
      "name": "GET /api/hives/:id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/hives/SN-CASA-001",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "hives",
            "SN-CASA-001"
          ]
        }
      }
    },
    {
      "name": "GET /api/hives/:id (404 ruche inconnue)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/hives/XX-NOPE-999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "hives",
            "XX-NOPE-999"
          ]
        }
      }
    },
    {
      "name": "POST measures (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/hives/SN-CASA-001/measures",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "hives",
            "SN-CASA-001",
            "measures"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"timestamp\": \"2026-10-31T10:00:00Z\",\n  \"weight_kg\": 36.84,\n  \"temp_internal_c\": 34.4,\n  \"humidity_pct\": 64\n}"
        }
      }
    },
    {
      "name": "POST measures (400 sans timestamp)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/hives/SN-CASA-001/measures",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "hives",
            "SN-CASA-001",
            "measures"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"weight_kg\": 36.84\n}"
        }
      }
    },
    {
      "name": "POST measures (404 ruche inconnue)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/hives/XX-NOPE-999/measures",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "hives",
            "XX-NOPE-999",
            "measures"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"timestamp\": \"2026-10-31T10:00:00Z\",\n  \"weight_kg\": 36.84,\n  \"temp_internal_c\": 34.4,\n  \"humidity_pct\": 64\n}"
        }
      }
    }
  ]
}